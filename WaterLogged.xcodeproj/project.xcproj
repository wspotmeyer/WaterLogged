{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "path": "CHANGELOG.md" },
    { "kind": "folder", "path": "docs" },
    { "path": "WaterLoggedWidgetsExtension.entitlements" },
    { "path": "README.md" },
    { "path": "LICENSE.md" },
    { "path": "CLAUDE.md" },
    { "path": "WaterLogged App Icon.icon", "target-membership": [ "WaterLogged/resources" ] },
    {
      "kind": "folder",
      "path": "WaterLogged",
      "target-membership": [
        "WaterLogged",
      ],
      "membership-exceptions": [
        {
          "target": "WaterLogged",
          "exclusions": [
            "Libraries/libdivecomputer/COPYING",
            "Resources/Icon Sources/Old WaterLogged Icon.ai",
            "Resources/Icon Sources/WaterLogged Icon.ai",
          ],
        }, {
          "target": "WaterLoggedWidgetsExtension",
          "inclusions": [
            "Widgets/StatsSnapshot.swift",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "WaterLoggedTests",
      "target-membership": [
        "WaterLoggedTests",
      ],
      "membership-exceptions": [
        {
          "target": "WaterLoggedTests",
          "exclusions": [
            "WaterLogged.xctestplan",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "WaterLoggedWidgets",
      "target-membership": [
        "WaterLoggedWidgetsExtension",
      ],
      "membership-exceptions": [
        {
          "target": "WaterLoggedWidgetsExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Scripts" },
    {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "WaterLoggedWidgetsExtension/frameworks" ] },
        { "path": "/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "WaterLoggedWidgetsExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/WaterLogged.app", "id": "527B79A22F4CB08A0028955B", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/WaterLoggedWidgetsExtension.appex", "id": "522DE2BA2FF1A9E200B75852", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "WaterLogged/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/WaterLoggedTests.xctest", "id": "52922E683016936A0051DA46", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
